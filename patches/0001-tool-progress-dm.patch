From d615ca8e09709abdf67d4de4ef3aee0946decdad Mon Sep 17 00:00:00 2001
From: Gaetan Cathelain <gaetan.cathelain@mobile.club>
Date: Sat, 8 Aug 2026 14:32:39 +0000
Subject: [PATCH] feat(display): DM-scoped tool_progress override
 (display.platforms.<platform>.tool_progress_dm)

Lets DMs stay verbose while group/channel chats keep the platform
tool_progress setting. Local patch pending upstream equivalent.
---
 gateway/run.py | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/gateway/run.py b/gateway/run.py
index 83342c3..d7ecd22 100644
--- a/gateway/run.py
+++ b/gateway/run.py
@@ -24761,6 +24761,14 @@ class GatewayRunner(GatewayAuthorizationMixin, GatewayKanbanWatchersMixin, Gatew
             if _env_tp and not _tool_progress_configured
             else (_resolved_tp or _env_tp or "all")
         )
+        # DM-scoped override: display.platforms.<platform>.tool_progress_dm
+        # lets DMs stay verbose while group/channel chats keep the platform
+        # tool_progress setting (e.g. Slack: off in channels, all in DMs).
+        if getattr(source, "chat_type", None) == "dm" and isinstance(_platform_cfg, dict):
+            _dm_tp = _platform_cfg.get("tool_progress_dm")
+            if _dm_tp is not None:
+                from gateway.display_config import _normalise as _tp_normalise
+                progress_mode = _tp_normalise("tool_progress", _dm_tp)
         # Tool progress grouping: "accumulate" (edit one bubble) or "separate" (one msg per tool)
         progress_grouping = resolve_display_setting(user_config, platform_key, "tool_progress_grouping") or "accumulate"
         from gateway.status_phrases import choose_status_phrase, resolve_status_phrase_catalog
-- 
