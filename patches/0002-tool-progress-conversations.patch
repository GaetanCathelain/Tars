+"""Per-conversation boundaries for a Slack bot that lives in several channels.
+
+Two independent guarantees, exercised together because they are configured
+together and only the pair is meaningful:
+
+  * **When it may speak** — the *mention gate* is the channel boundary. There
+    is no ``allowed_channels`` whitelist in this configuration: the bot is
+    reachable on every shared surface it is invited to, but only by a *fresh*
+    @-mention on the message itself. ``strict_mention`` disables thread
+    auto-follow and session-presence wake; ``free_response_channels`` exempts
+    the one workshop channel; a 1:1 IM is exempt by construction (it never
+    enters the channel gate). An MPIM (group DM) is a shared surface, so it
+    obeys the same mention gate as a channel. Who may summon it at all is a
+    separate, env-side control (``allowed_users``), not exercised here.
+    This half is configuration only — no local code — and the tests below pin
+    that the existing gate ladder in ``_handle_slack_message`` really delivers
+    it.
+
+  * **What it shows while it works** — tool-call progress is *cosmetic* and
+    per-conversation. ``display.platforms.<platform>.tool_progress_conversations``
+    maps a chat id to a ``tool_progress`` mode, so the workshop channel and the
+    owner's DM narrate their tool calls while every other shared surface stays
+    quiet. Tool *capability* is deliberately NOT conversation-scoped: a session
+    the mention gate let through gets the identical toolset wherever it runs,
+    the model receives the identical tool schema (a stable schema is what keeps
+    the prompt cache warm), tools really execute there, and the final answer is
+    delivered everywhere — quiet surfaces included. Hiding the narration must
+    never disarm the agent.
+
+Gating tests drive the real ``SlackAdapter._handle_slack_message``; display and
+toolset tests drive a real gateway turn through ``GatewayRunner._run_agent``,
+reusing the harness in ``tests/gateway/test_run_progress_topics.py``.
+"""
+
+import importlib
+import inspect
+import sys
+import tempfile
+import time
+import types
+from pathlib import Path
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+import yaml
+
+from gateway.config import Platform, PlatformConfig
+from gateway.session import SessionSource
+from tests.gateway.test_run_progress_topics import ProgressCaptureAdapter, _make_runner
+
+
+# ---------------------------------------------------------------------------
+# Mock slack-bolt if not installed (same pattern as test_slack_mention.py)
+# ---------------------------------------------------------------------------
+
+def _ensure_slack_mock():
+    if "slack_bolt" in sys.modules and hasattr(sys.modules["slack_bolt"], "__file__"):
+        return
+
+    slack_bolt = MagicMock()
+    slack_bolt.async_app.AsyncApp = MagicMock
+    slack_bolt.adapter.socket_mode.async_handler.AsyncSocketModeHandler = MagicMock
+
+    slack_sdk = MagicMock()
+    slack_sdk.web.async_client.AsyncWebClient = MagicMock
+
+    for name, mod in [
+        ("slack_bolt", slack_bolt),
+        ("slack_bolt.async_app", slack_bolt.async_app),
+        ("slack_bolt.adapter", slack_bolt.adapter),
+        ("slack_bolt.adapter.socket_mode", slack_bolt.adapter.socket_mode),
+        ("slack_bolt.adapter.socket_mode.async_handler", slack_bolt.adapter.socket_mode.async_handler),
+        ("slack_sdk", slack_sdk),
+        ("slack_sdk.web", slack_sdk.web),
+        ("slack_sdk.web.async_client", slack_sdk.web.async_client),
+    ]:
+        sys.modules.setdefault(name, mod)
+
+
+_ensure_slack_mock()
+
+import plugins.platforms.slack.adapter as _slack_mod  # noqa: E402
+
+_slack_mod.SLACK_AVAILABLE = True
+
+from plugins.platforms.slack.adapter import SlackAdapter  # noqa: E402
+
+
+BOT_USER_ID = "U_BOT_123"
+OWNER_ID = "U08BDJAMSRZ"
+
+HOME_CHANNEL = "C0BP2GZUFSR"      # free-response + narrated tool calls
+SHARED_CHANNEL = "C0BFQ5WFYTB"    # mention-only, quiet
+OTHER_CHANNEL = "GQ07CQXT7"       # another shared surface, quiet
+OWNER_DM = "D0BBYNM01BL"          # 1:1 IM: mention-exempt + narrated
+GROUP_DM = "G0GROUPDM01"          # MPIM: mention-only, quiet
+RANDOM_CHANNEL = "C_RANDOM_9999"  # never configured anywhere
+
+FINAL_ANSWER = "here is what the file says"
+
+# The live display configuration this suite pins, in the shape the code reads
+# it: Slack channels are quiet by default, the DM is verbose via
+# ``tool_progress_dm``, and the workshop channel is opted back in by chat id.
+#
+# ``platform_tool_conversations`` is the WITHDRAWN toolset gate (a misreading
+# of the same policy: it emptied the toolset outside the listed conversations).
+# It is left in this fixture on purpose — an operator's config may still carry
+# it, and the tests below require it to have no effect on capability whatever.
+# NEVER re-introduce this key as a live feature — it is the withdrawn
+# capability gate, and it appears here only as inert ballast to be ignored.
+DISPLAY_CONFIG = {
+    "platform_toolsets": {"slack": ["hermes-slack"]},
+    "platform_tool_conversations": {"slack": [HOME_CHANNEL, OWNER_DM]},
+    "display": {
+        "platforms": {
+            "slack": {
+                "tool_progress": "off",
+                "tool_progress_dm": "all",
+                "tool_progress_conversations": {HOME_CHANNEL: "all"},
+            }
+        }
+    },
+}
+
+# The shape the DEPLOY actually writes — and the reason it differs.
+#
+# ``tool_progress_dm`` is one axis too coarse on Slack: the adapter collapses
+# MPIMs into DMs (``adapter.py:5512``, ``is_dm = channel_type in {"im","mpim"}``
+# → ``chat_type="dm"``), so ``tool_progress_dm: all`` would narrate interim tool
+# calls in every *group* DM too — a shared surface. The deployed config
+# therefore carries NO ``tool_progress_dm`` key at all and names each verbose
+# conversation by chat id, the 1:1 DM included.
+#
+# ``tool_progress`` is the QUOTED string "off", never a bare ``off``: YAML 1.1
+# parses bare ``off`` to the boolean ``False`` (see the False-shape test below).
+MAP_ONLY_CONFIG = {
+    "platform_toolsets": {"slack": ["hermes-slack"]},
+    "display": {
+        "platforms": {
+            "slack": {
+                "tool_progress": "off",
+                "tool_progress_conversations": {HOME_CHANNEL: "all", OWNER_DM: "all"},
+            }
+        }
+    },
+}
