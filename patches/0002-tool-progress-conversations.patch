+@pytest.mark.asyncio
+async def test_bare_off_in_yaml_resolves_to_quiet(monkeypatch, tmp_path):
+    """YAML 1.1 parses a bare ``off`` to the boolean ``False``.
+
+    ``_normalise`` maps that back to the string ``"off"``, so the resolved
+    ``progress_mode`` is ``"off"`` and the channel is quiet — the bare and the
+    quoted spellings agree. The deploy still writes the QUOTED ``"off"``: the
+    equivalence rests on one ``value is False`` branch in ``_normalise`` and on
+    ``_resolved_tp or _env_tp or "all"`` never seeing a falsy value, and a
+    config file should not depend on either.
+    """
+    from gateway.display_config import _normalise
+
+    assert _normalise("tool_progress", False) == "off"
+
+    config = {
+        "platform_toolsets": {"slack": ["hermes-slack"]},
+        "display": {
+            "platforms": {
+                "slack": {
+                    "tool_progress": False,  # what `tool_progress: off` becomes
+                    "tool_progress_conversations": {HOME_CHANNEL: "all"},
+                }
+            }
+        },
+    }
+    probe = _probe_file(tmp_path)
+    agent, quiet, _ = await _turn(
+        monkeypatch, tmp_path, chat_id=SHARED_CHANNEL, chat_type="group",
+        tool_file=probe, config=config,
+    )
+    assert "hello from a tool call" in agent.tool_result, "no tool ran, so silence proves nothing"
+    assert quiet.sent == []
+
+    # …and the per-conversation map still wins over the False form.
+    _, loud, _ = await _turn(
+        monkeypatch, tmp_path, chat_id=HOME_CHANNEL, chat_type="group",
+        tool_file=probe, config=config,
+    )
+    assert loud.sent, "the workshop channel narrated nothing"
