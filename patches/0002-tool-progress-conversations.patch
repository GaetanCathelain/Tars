+# ---------------------------------------------------------------------------
+# One real gateway turn per conversation — capability, display, final answer
+# ---------------------------------------------------------------------------
+
+def _agent_class(sink, *, tool_file=None):
+    """Build the fake ``AIAgent`` the gateway will construct for a turn.
+
+    ``enabled_toolsets`` is the kwarg the gateway resolves per turn — the
+    capability question — so capturing it reads the answer at the source,
+    upstream of the tool schemas the model is offered.
+
+    With ``tool_file`` set the agent also does what a real turn does: it builds
+    the model's tool definitions from the toolset it was handed and dispatches
+    a real tool through the real registry, so a test can show tools genuinely
+    run in that conversation rather than merely being listed.
+    """
+
+    class _Agent:
+        def __init__(self, **kwargs):
+            self.enabled_toolsets = kwargs.get("enabled_toolsets")
+            self.tool_progress_callback = kwargs.get("tool_progress_callback")
+            self.tools = []
+            self.tool_definitions = []
+            self.tool_result = None
+            sink.append(self)
+
+        def run_conversation(self, message, conversation_history=None, task_id=None):
+            if tool_file is not None:
+                from model_tools import get_tool_definitions
+                from tools.registry import registry
+
+                self.tool_definitions = get_tool_definitions(
+                    enabled_toolsets=self.enabled_toolsets, quiet_mode=True
+                )
+                cb = self.tool_progress_callback
+                if cb is not None:
+                    cb("tool.started", "read_file", str(tool_file), {"path": str(tool_file)})
+                self.tool_result = registry.dispatch("read_file", {"path": str(tool_file)})
+                # Give the progress consumer a turn on the loop, exactly like
+                # the fake agents in test_run_progress_topics.py.
+                time.sleep(0.35)
+            return {"final_response": FINAL_ANSWER, "messages": [], "api_calls": 1}
+
+    return _Agent
+
+
+async def _turn(monkeypatch, tmp_path, *, chat_id, chat_type, tool_file=None,
+                config=DISPLAY_CONFIG):
+    """Run one real gateway turn for a Slack conversation.
+
+    Returns ``(agent, adapter, result)``: the agent the gateway constructed
+    (carrying the toolset it was given), the adapter that captured every
+    interim send, and the turn result carrying the final answer.
+    """
+    home = Path(tempfile.mkdtemp(dir=tmp_path))
+    (home / "config.yaml").write_text(yaml.dump(config), encoding="utf-8")
+
+    fake_dotenv = types.ModuleType("dotenv")
+    fake_dotenv.load_dotenv = lambda *args, **kwargs: None
+    monkeypatch.setitem(sys.modules, "dotenv", fake_dotenv)
+
+    sink = []
+    fake_run_agent = types.ModuleType("run_agent")
+    fake_run_agent.AIAgent = _agent_class(sink, tool_file=tool_file)
+    monkeypatch.setitem(sys.modules, "run_agent", fake_run_agent)
+
+    adapter = ProgressCaptureAdapter(platform=Platform.SLACK)
+    runner = _make_runner(adapter)
+    gateway_run = importlib.import_module("gateway.run")
+    monkeypatch.setattr(gateway_run, "_hermes_home", home)
+    monkeypatch.setattr(gateway_run, "_resolve_runtime_agent_kwargs", lambda: {"api_key": "***"})
+
+    source = SessionSource(
+        platform=Platform.SLACK,
+        chat_id=chat_id,
+        chat_type=chat_type,
+        thread_id=None,
+    )
+    result = await runner._run_agent(
+        message="what does the file say?",
+        context_prompt="",
+        history=[],
+        source=source,
+        session_id=f"sess-{chat_id}",
+        session_key=f"agent:main:slack:{chat_type}:{chat_id}",
+        event_message_id="1786400000.000001",
+    )
+    assert sink, "the gateway never constructed an agent for this turn"
+    return sink[0], adapter, result
+
+
+def _probe_file(tmp_path):
+    path = tmp_path / "tars-probe.txt"
+    path.write_text("hello from a tool call", encoding="utf-8")
+    return path
+
+
+# --- (a) capability is identical everywhere -------------------------------
+
+@pytest.mark.asyncio
+async def test_public_channel_gets_the_same_toolset_as_the_workshop(monkeypatch, tmp_path):
+    """A fresh mention in an arbitrary public channel is a valid session, so it
+    is armed exactly like the workshop channel: same toolset, byte for byte.
+
+    Identical toolsets are also what keeps the tool schema — and therefore the
+    prompt cache — stable across conversations.
+    """
+    public, _, _ = await _turn(
+        monkeypatch, tmp_path, chat_id=SHARED_CHANNEL, chat_type="group"
+    )
+    workshop, _, _ = await _turn(
