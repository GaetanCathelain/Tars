+# ---------------------------------------------------------------------------
+# Mention gating — real _handle_slack_message
+# ---------------------------------------------------------------------------
+
+@pytest.fixture
+def adapter():
+    a = SlackAdapter(PlatformConfig(enabled=True, token="xoxb-fake-token"))
+    a._app = MagicMock()
+    a._app.client = AsyncMock()
+    a._bot_user_id = BOT_USER_ID
+    a._running = True
+    a.handle_message = AsyncMock()
+    # The deployed boundary configuration: no channel whitelist — the mention
+    # gate alone decides, on every shared surface the bot is invited to.
+    a.config.extra.update(
+        free_response_channels=HOME_CHANNEL,
+        strict_mention=True,
+        require_mention=True,
+    )
+    return a
+
+
+def _event(channel, text, ts, *, channel_type="channel", thread_ts=None, mentioned=False):
+    if mentioned:
+        text = f"<@{BOT_USER_ID}> {text}"
+    event = {
+        "channel": channel,
+        "channel_type": channel_type,
+        "user": OWNER_ID,
+        "text": text,
+        "ts": ts,
+    }
+    if thread_ts is not None:
+        event["thread_ts"] = thread_ts
+    return event
+
+
+async def _run(adapter, event, *, thread_awake=False):
+    """Deliver ``event`` to the real handler.
+
+    ``thread_awake=True`` arms every auto-follow path that could wake the bot
+    on an un-mentioned thread reply — mentioned-thread memory, an active
+    session for the thread, and a thread parent that @-mentioned the bot — so
+    a test asserting silence proves the gate, not an unarmed fixture.
+    """
+    parent_text = f"<@{BOT_USER_ID}> look at this" if thread_awake else ""
+    if thread_awake and event.get("thread_ts"):
+        adapter._register_mentioned_thread(event["thread_ts"])
+    with patch.object(
+        adapter, "_resolve_user_name", new=AsyncMock(return_value="gaetan")
+    ), patch.object(
+        adapter, "_fetch_thread_context", new=AsyncMock(return_value=None)
+    ), patch.object(
+        adapter, "_fetch_thread_parent_text", new=AsyncMock(return_value=parent_text)
+    ), patch.object(
+        adapter, "_bot_authored_thread_root", new=AsyncMock(return_value=thread_awake)
+    ), patch.object(
+        adapter, "_has_active_session_for_thread", return_value=thread_awake
+    ):
+        await adapter._handle_slack_message(event)
+
+
+@pytest.mark.asyncio
+async def test_home_channel_top_level_unmentioned_is_processed(adapter):
+    """1. The workshop channel is free-response: no @-mention needed."""
+    await _run(adapter, _event(HOME_CHANNEL, "status?", ts="1786400000.000001"))
+    adapter.handle_message.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_home_channel_thread_reply_unmentioned_is_processed(adapter):
+    """2. Free-response covers thread replies, not just top-level messages."""
+    await _run(
+        adapter,
+        _event(HOME_CHANNEL, "and the second one?", ts="1786400000.000003",
+               thread_ts="1786400000.000002"),
+    )
+    adapter.handle_message.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_owner_dm_unmentioned_is_processed(adapter):
+    """3. A 1:1 IM never enters the channel gate — no mention required."""
+    await _run(
+        adapter,
+        _event(OWNER_DM, "thanks!", ts="1786400000.000004", channel_type="im"),
+    )
+    adapter.handle_message.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_shared_channel_unmentioned_thread_reply_is_ignored(adapter):
+    """4. The regression: an un-mentioned thank-you in an engaged thread.
+
+    Every auto-follow path is armed. ``strict_mention`` is evaluated at
+    ``adapter.py:5707``, *before* the ``_should_wake_on_unmentioned_message``
+    branch at 5721, so all five wake paths are unreachable.
+    """
+    await _run(
+        adapter,
+        _event(SHARED_CHANNEL, "Mrc le goat", ts="1786400000.000006",
+               thread_ts="1786400000.000005"),
+        thread_awake=True,
+    )
+    adapter.handle_message.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_shared_channel_wake_paths_fire_without_strict_mention(adapter):
+    """Control for the test above: the same armed thread DOES wake the bot
+    when ``strict_mention`` is off. Proves the arming is real and that
+    ``strict_mention`` is the gate doing the work."""
+    adapter.config.extra["strict_mention"] = False
+    await _run(
+        adapter,
+        _event(SHARED_CHANNEL, "Mrc le goat", ts="1786400000.000008",
+               thread_ts="1786400000.000007"),
+        thread_awake=True,
+    )
+    adapter.handle_message.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_shared_channel_fresh_mention_is_processed(adapter):
+    """5. An explicit @-mention still reaches the bot outside the workshop."""
+    await _run(
+        adapter,
+        _event(SHARED_CHANNEL, "can you check this?", ts="1786400000.000009",
+               mentioned=True),
+    )
+    adapter.handle_message.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_group_dm_unmentioned_thread_reply_is_ignored(adapter):
+    """6. MPIM verdict: a group DM is a shared surface, not a DM.
+
+    ``adapter.py:5528`` sets ``is_one_to_one_dm = channel_type == "im"``, so an
+    MPIM enters the same gate ladder as a channel at 5654. With every
+    auto-follow path armed, ``strict_mention`` (5707) still fires first and
+    drops the un-mentioned reply.
+    """
+    await _run(
+        adapter,
+        _event(GROUP_DM, "Mrc le goat", ts="1786400000.000010",
+               channel_type="mpim", thread_ts="1786400000.000009.5"),
+        thread_awake=True,
+    )
+    adapter.handle_message.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_group_dm_fresh_mention_is_processed(adapter):
+    """6b. The other half of the MPIM verdict: a group DM is reachable — a
+    fresh @-mention falls through the whole elif ladder and is processed."""
+    await _run(
+        adapter,
+        _event(GROUP_DM, "hey bot", ts="1786400000.000011",
+               channel_type="mpim", mentioned=True),
+    )
+    adapter.handle_message.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_never_configured_channel_fresh_mention_is_processed(adapter):
