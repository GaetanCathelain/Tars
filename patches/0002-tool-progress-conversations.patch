+@pytest.mark.asyncio
+async def test_toolsets_never_vary_by_conversation(monkeypatch, tmp_path):
+    """The guard against re-introducing conversation-scoped *capability*.
+
+    Five conversations — the workshop, two shared channels, a group DM and the
+    owner's DM — with a stale ``platform_tool_conversations`` allowlist naming
+    only two of them in the very config being read. Every session must still be
+    handed the same non-empty toolset: display is per-conversation, capability
+    is not.
+
+    The resolver's *signature* is pinned too: ``_get_platform_tools`` takes the
+    config and a platform key and nothing else. It cannot see a conversation,
+    so conversation-scoped capability cannot be re-introduced without changing
+    this line first.
+    """
+    from hermes_cli.tools_config import _get_platform_tools
+
+    assert 'chat_id' not in inspect.signature(_get_platform_tools).parameters
+
+    conversations = [
+        (HOME_CHANNEL, "group"),
+        (SHARED_CHANNEL, "group"),
+        (OTHER_CHANNEL, "group"),
+        (GROUP_DM, "dm"),
+        (OWNER_DM, "dm"),
+    ]
+    resolved = {}
+    for chat_id, chat_type in conversations:
+        agent, _, _ = await _turn(
+            monkeypatch, tmp_path, chat_id=chat_id, chat_type=chat_type
+        )
+        resolved[chat_id] = agent.enabled_toolsets
+
+    assert all(toolsets for toolsets in resolved.values()), resolved
+    assert len({tuple(toolsets) for toolsets in resolved.values()}) == 1, resolved
