#!/usr/bin/env bash
# Ingest a credential into the Tars SOPS+age store (secrets/tars.sops.yaml),
# or hand off a raw one-time value to a file. Plaintext never touches argv,
# disk-unencrypted, or stdout/stderr.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  tars-secret KEY_NAME               upsert KEY_NAME into secrets/tars.sops.yaml
  tars-secret --out /abs/path LABEL  write raw value to /abs/path (0600), no SOPS
EOF
  exit 1
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

# Prompts on stderr; reads silently from a tty, falls back to plain stdin
# (one line) when stdin isn't a tty — lets tests pipe a dummy value in.
read_secret() {
  local prompt="$1"
  if [ -t 0 ]; then
    read -rs -p "${prompt}: " value || true
    printf '\n' >&2
  else
    IFS= read -r value || true
  fi
}

[ $# -ge 1 ] || usage

if [ "$1" = "--out" ]; then
  [ $# -eq 3 ] || usage
  out_path="$2"
  label="$3"
  case "$out_path" in
    /*) ;;
    *) echo "error: --out path must be absolute" >&2; exit 1 ;;
  esac
  [ -e "$out_path" ] && { echo "error: $out_path already exists, refusing to overwrite" >&2; exit 1; }

  read_secret "value for $label"
  [ -n "${value:-}" ] || { echo "error: empty value rejected" >&2; exit 1; }

  ( umask 077; printf '%s' "$value" > "$out_path" )
  len=${#value}
  unset value
  echo "wrote $label to $out_path (value length: $len chars)"
  exit 0
fi

[ $# -eq 1 ] || usage
key="$1"
[[ "$key" =~ ^[A-Z][A-Z0-9_]*$ ]] || {
  echo "error: KEY_NAME must match ^[A-Z][A-Z0-9_]*\$, got: $key" >&2
  exit 1
}

read_secret "value for $key"
[ -n "${value:-}" ] || { echo "error: empty value rejected" >&2; exit 1; }

cd "$repo_root"
mkdir -p secrets
secrets_rel="secrets/tars.sops.yaml"
secrets_file="$repo_root/$secrets_rel"

existing=""
if [ -f "$secrets_file" ]; then
  existing="$(sops -d --input-type yaml --output-type yaml "$secrets_rel")" || {
    echo "error: failed to decrypt $secrets_rel" >&2
    exit 1
  }
fi

# YAML-escape the value for a double-quoted scalar.
esc="${value//\\/\\\\}"
esc="${esc//\"/\\\"}"

merged="$(
  if [ -n "$existing" ]; then
    printf '%s\n' "$existing" | grep -v -E "^${key}:" || true
  fi
  printf '%s: "%s"\n' "$key" "$esc"
)"

tmpfile="$(mktemp "$repo_root/secrets/.tars.sops.yaml.XXXXXX")"
trap 'rm -f "$tmpfile"' EXIT

printf '%s\n' "$merged" \
  | sops -e --input-type yaml --output-type yaml --filename-override "$secrets_rel" /dev/stdin \
  > "$tmpfile"
mv "$tmpfile" "$secrets_file"
trap - EXIT

len=${#value}
unset value esc merged existing
echo "upserted $key into $secrets_rel (value length: $len chars)"
